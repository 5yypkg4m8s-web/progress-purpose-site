---
/*
 * Walking crowd. Adapted from "Skiper 39 Canvas_Landing_004" by Skiper UI (@gurvinder-singh02),
 * itself inspired by https://codepen.io/zadvorsky/pen/xxwbBQV. Illustrations: Open Peeps by Pablo Stanley (CC0).
 * Rewritten here without React or GSAP to keep the site small and fast.
 */
---
<section class="crowd" aria-labelledby="crowd-h">
  <div class="wrap">
    <p class="eyebrow">For everyone</p>
    <h2 id="crowd-h">Helping everyone prepare for adulthood.</h2>
    <p class="lede">Resources and written support for the people who plan, deliver and commission transition: SENCOs, teachers, college leaders, local authority teams, and the families and young people they work with.</p>
    <p class="crowd__credit">Illustrations: <a href="https://www.openpeeps.com/">Open Peeps</a> (CC0). Animation adapted from Skiper UI.</p>
  </div>
  <canvas class="crowd__canvas" data-crowd aria-hidden="true"></canvas>
</section>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-crowd]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const COLS = 15, ROWS = 7;
    // Figures left out of the walking crowd (knives, eye patches, grimaces) so the mood stays calm.
    const SKIP = new Set([5, 7, 17, 22, 30, 60, 61, 72, 83, 84, 92, 100]);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rand = (min: number, max: number) => min + Math.random() * (max - min);
    const easeIn = (t: number) => t * t; // power2.in

    type Peep = { cell: number; x: number; y: number; anchorY: number; dir: number; startX: number; endX: number; startY: number; speed: number; t0: number };
    const img = new Image();
    let peeps: Peep[] = [];
    let w = 0, h = 0, scale = 1, cellW = 0, cellH = 0, dpr = 1, raf = 0, visible = false;

    const reset = (p: Peep, now: number, spread: boolean) => {
      p.dir = Math.random() > 0.5 ? 1 : -1;
      const pw = cellW * scale, ph = cellH * scale;
      p.startY = h - ph + (100 - 250 * easeIn(Math.random()));
      p.startX = p.dir === 1 ? -pw : w + pw;
      p.endX = p.dir === 1 ? w : 0;
      p.anchorY = p.startY;
      p.speed = rand(0.5, 1.5);
      p.t0 = now - (spread ? Math.random() * (10 / p.speed) : 0);
    };

    const setup = () => {
      dpr = window.devicePixelRatio || 1;
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      scale = Math.min(1, Math.max(200, h * 0.62) / cellH);
      const now = performance.now() / 1000;
      peeps = [];
      for (let i = 0; i < COLS * ROWS; i++) {
        if (SKIP.has(i)) continue;
        const p = { cell: i } as Peep;
        reset(p, now, true);
        peeps.push(p);
      }
      peeps.sort((a, b) => a.anchorY - b.anchorY);
      draw(now);
    };

    const draw = (now: number) => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      const pw = cellW * scale, ph = cellH * scale;
      let resorted = false;
      for (const p of peeps) {
        let prog = (now - p.t0) * p.speed / 10;
        if (prog >= 1) { reset(p, now, false); prog = 0; resorted = true; }
        const tween = (now - p.t0) * p.speed;
        const bob = (1 - Math.cos((tween / 0.5) * Math.PI * 2)) / 2;
        const x = p.startX + (p.endX - p.startX) * prog;
        const y = p.startY - 10 * bob;
        ctx.save();
        ctx.translate(x, y);
        ctx.scale(p.dir, 1);
        ctx.drawImage(img, (p.cell % COLS) * cellW, Math.floor(p.cell / COLS) * cellH, cellW, cellH, 0, 0, pw, ph);
        ctx.restore();
      }
      if (resorted) peeps.sort((a, b) => a.anchorY - b.anchorY);
    };

    const loop = () => {
      if (!visible) return;
      draw(performance.now() / 1000);
      raf = requestAnimationFrame(loop);
    };

    img.onload = () => {
      cellW = img.naturalWidth / COLS; cellH = img.naturalHeight / ROWS;
      setup();
      if (!reduced) {
        new IntersectionObserver(([e]) => {
          visible = e.isIntersecting;
          cancelAnimationFrame(raf);
          if (visible) loop();
        }).observe(canvas);
      }
      let lastW = canvas.clientWidth;
      addEventListener('resize', () => { if (canvas.clientWidth !== lastW) { lastW = canvas.clientWidth; setup(); } });
    };
    // Only fetch the image when the section is about to scroll into view
    const loader = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { loader.disconnect(); img.src = '/images/crowd-sprite.png'; }
    }, { rootMargin: '600px' });
    loader.observe(canvas);
  }
</script>
