---
import { SITE_NAME, NAV, LEGAL_NAV, CONTACT_EMAIL, ADDRESS, LINKEDIN_URL, ANALYTICS } from '../config.mjs';
import Wordmark from './Wordmark.astro';
const emailIsReal = CONTACT_EMAIL.includes('@') && !CONTACT_EMAIL.includes('[');
const emailBreakable = CONTACT_EMAIL.replace('@', '@<wbr>');
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer__brand">
      <Wordmark tone="light" />
      <p class="footer__statement">Practical support for better SEND transitions.</p>
    </div>
    <div class="footer__lower">
      <nav aria-label="Site">
        <ul class="footer__nav">{NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}<li><a href="/faq/">FAQs</a></li><li><a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li></ul>
      </nav>
      <nav aria-label="Legal">
        <ul class="footer__legal">
          {LEGAL_NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          {ANALYTICS.enabled && <li><a href="#" data-reopen-cookiebar>Cookie settings</a></li>}
        </ul>
      </nav>
      <div class="footer__base">
        <p>{emailIsReal ? <a href={`mailto:${CONTACT_EMAIL}`} set:html={emailBreakable} /> : <span>{CONTACT_EMAIL}</span>}</p>
        {!ADDRESS.startsWith('[') && <address>{ADDRESS}</address>}
        <p>&copy; {new Date().getFullYear()} {SITE_NAME}. This site sets no tracking cookies.</p>
      </div>
    </div>
  </div>
</footer>
