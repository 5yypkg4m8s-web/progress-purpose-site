---
import { SITE_NAME, TAGLINE, NAV, LEGAL_NAV, CONTACT_EMAIL, ADDRESS, LINKEDIN_URL, ANALYTICS } from '../config.mjs';
const emailIsReal = CONTACT_EMAIL.includes('@') && !CONTACT_EMAIL.includes('[');
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <a class="wordmark" href="/">{SITE_NAME}</a>
        <p class="muted" style="color:#d8d2c8;margin-top:1rem">{TAGLINE}. Written and product-based support for schools, colleges and local authorities.</p>
      </div>
      <nav aria-label="Site">
        <h2>Site</h2>
        <ul>{NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}<li><a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li></ul>
      </nav>
      <nav aria-label="Legal">
        <h2>Legal</h2>
        <ul>
          {LEGAL_NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          {ANALYTICS.enabled && <li><a href="#" data-reopen-cookiebar>Cookie settings</a></li>}
        </ul>
      </nav>
    </div>
    <div class="footer__base">
      <p><strong>{SITE_NAME}</strong> &middot;
        {emailIsReal ? <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> : <span>{CONTACT_EMAIL}</span>}</p>
      <address>{ADDRESS}</address>
      <p>&copy; {new Date().getFullYear()} {SITE_NAME}. This site sets no tracking cookies.</p>
    </div>
  </div>
</footer>
