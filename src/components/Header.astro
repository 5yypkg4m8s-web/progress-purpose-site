---
import { NAV } from '../config.mjs';
import Wordmark from './Wordmark.astro';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap">
    <Wordmark />
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {NAV.map((i) => (
          <li><a href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}>{i.label}</a></li>
        ))}
        <li><a class="btn btn--primary" href="/contact/">Request a quote</a></li>
      </ul>
    </nav>
  </div>
</header>
