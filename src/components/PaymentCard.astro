---
// Decorative only: no inputs, no card data. Real payment happens on the provider's hosted page.
---
<div class="pay">
  <div class="pay__card" aria-hidden="true">
    <div class="pay__head"><span>Payment card</span><span class="pay__logo"><i></i><i></i></span></div>
    <div class="pay__num">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull;</div>
    <div class="pay__foot"><div><small>Card holder</small>YOUR NAME</div><div><small>Expires</small>MM/YY</div></div>
  </div>
  <div>
    <h2>How buying works</h2>
    <ol class="pay__steps">
      <li>Choose a resource and tick the delivery box.</li>
      <li>Pay on a secure page hosted by [PAYMENT PROVIDER: Stripe or PayPal]. Card details are never entered on this site.</li>
      <li>Your download is delivered straight away.</li>
    </ol>
  </div>
</div>

<style>
  .pay { display: grid; gap: 2.5rem; align-items: center; margin-bottom: 3rem; }
  @media (min-width: 800px) { .pay { grid-template-columns: 26rem 1fr; gap: 4rem; } }
  .pay h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .pay__card {
    position: relative; overflow: hidden; width: 100%; max-width: 26rem; aspect-ratio: 1.75; border-radius: 1.25rem;
    padding: 1.5rem 1.75rem; color: #fff; display: flex; flex-direction: column; justify-content: space-between;
    background: linear-gradient(to right bottom, #323941, #1f2933 60%, #14191f);
    box-shadow: 0 33px 50px -18px rgb(31 41 51 / 0.6); transform: rotate(-3deg);
  }
  .pay__card::before, .pay__card::after {
    content: ''; position: absolute; width: 18rem; height: 18rem; border-radius: 50%; filter: blur(12px);
  }
  .pay__card::before { border: 1rem solid #b4472a; left: -17%; top: -3rem; }
  .pay__card::after { border: 1rem solid #4b2e5a; left: 45%; top: 55%; }
  .pay__card > * { position: relative; z-index: 1; }
  .pay__head, .pay__foot { display: flex; justify-content: space-between; align-items: center; font-weight: 700; }
  .pay__num { font-size: clamp(1.1rem, 4.6vw, 1.5rem); letter-spacing: 0.08em; }
  .pay__foot small { display: block; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.85; }
  .pay__logo { display: inline-flex; }
  .pay__logo i { width: 1.6rem; height: 1.6rem; border-radius: 50%; background: #b4472a; opacity: 0.95; }
  .pay__logo i + i { background: #faf6f0; margin-left: -0.6rem; opacity: 0.9; }
  .pay__steps { padding-left: 1.3em; margin: 0; }
  .pay__steps li { margin-bottom: 0.6rem; max-width: 46ch; }
  @media (prefers-reduced-motion: no-preference) {
    .pay__card { animation: float 6s ease-in-out infinite; }
    @keyframes float { 50% { transform: rotate(-3deg) translateY(-8px); } }
  }
</style>
