---
import Cover from './Cover.astro';
import { CONTACT_EMAIL } from '../config.mjs';
const { item, kind } = Astro.props; // kind: 'product' | 'service'
const isProduct = kind === 'product';
// Anything still in [square brackets] is an unfinished placeholder; keep it off the public page.
const includes = item.includes.filter((i) => !i.startsWith('['));
const showLicence = isProduct && item.licence && !item.licence.startsWith('[');
---
<article class="card" data-reveal>
  <Cover variant={item.cover} label={isProduct ? item.format : (item.coverTag || 'Written service')} design={item.design} image={item.image} kicker={item.coverKicker} title={item.coverTitle} />
  <div class="card__body">
    <p class="card__kind">{isProduct ? (item.free ? 'Free download' : 'Digital download') : 'Enquiry-led'}</p>
    <h3>{item.name}</h3>
    <p>{item.summary}</p>
    <ul>{includes.map((i) => <li>{i}</li>)}</ul>
    <dl class="meta">
      <div><dt>Who it is for</dt><dd>{item.forWho}</dd></div>
      {showLicence && <div><dt>Licence</dt><dd>{item.licence}</dd></div>}
    </dl>
    <div class="card__foot">
      {isProduct ? (
        <>
          <div>
            <p class="price" style="margin:0"><small>{item.priceLabel || 'Price'}</small>{item.price}</p>
            {item.multiSiteLicence && (
              <p class="hint" style="margin:0.35rem 0 0">Single-setting licence. For a multi-site licence, contact <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
            )}
          </div>
          {item.buyUrl ? (
            item.free
              ? <a class="btn btn--primary" href={item.buyUrl} target="_blank" rel="noopener noreferrer">Get the guide<span class="visually-hidden">: {item.name} (opens in a new tab)</span></a>
              : <a class="btn btn--primary" href={item.buyUrl} target="_blank" rel="noopener noreferrer" data-buy>Buy now<span class="visually-hidden">: {item.name} (opens in a new tab)</span></a>
          ) : null /* no button until the Payhip link exists */}
        </>
      ) : (
        <>
          <p class="price" style="margin:0"><small>Fee</small><span style="font-size:1.1rem">{item.fee || 'Quote on request'}</span></p>
          <a class="btn btn--primary" href={`/contact/?package=${item.id}`}>{item.cta}<span class="visually-hidden">: {item.name}</span></a>
        </>
      )}
    </div>
  </div>
</article>
