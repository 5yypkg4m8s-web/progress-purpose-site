---
import Base from '../layouts/Base.astro';

const icon = (d: string) =>
  `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;

const pages = [
  {
    icon: icon('<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z"/>'),
    title: 'Resources',
    description: 'Editable templates and toolkits to download',
    href: '/resources/',
  },
  {
    icon: icon('<path d="M20 8H4a1 1 0 0 0-1 1v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a1 1 0 0 0-1-1Z"/><path d="M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>'),
    title: 'Packages',
    description: 'Written support for schools and local authorities',
    href: '/packages/',
  },
  {
    icon: icon('<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/>'),
    title: 'About',
    description: 'Who writes these resources, and why',
    href: '/about/',
  },
  {
    icon: icon('<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-10 6L2 7"/>'),
    title: 'Contact',
    description: 'Send an enquiry or request a quote',
    href: '/contact/',
  },
];
---
<Base title="Page not found" noindex description="This page could not be found.">
  <section class="notfound">
    <div class="wrap">
      <span class="notfound__badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m15 9-6 6M9 9l6 6"/></svg>
      </span>
      <h1>Page not found</h1>
      <p class="lede">That page doesn't exist, or has moved. Here are some pages that might help instead.</p>

      <div class="notfound__grid">
        {pages.map((p) => (
          <a class="notfound__card" href={p.href}>
            <span class="notfound__cardicon" set:html={p.icon} />
            <span class="notfound__cardtext">
              <strong>{p.title}</strong>
              <span>{p.description}</span>
            </span>
            <span class="notfound__arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>

      <a class="btn btn--ghost btn--plain" href="/">&larr; Back to home</a>
    </div>
  </section>
</Base>

<style>
  .notfound { padding-block: clamp(4rem, 10vw, 7rem); text-align: center; }
  .notfound .wrap { max-width: 40rem; }
  .notfound__badge {
    display: inline-grid; place-items: center; width: 3rem; height: 3rem; margin-bottom: 1.5rem;
    border-radius: 1rem; border: 1px solid var(--line); background: var(--sand-2); color: var(--terra);
  }
  .notfound h1 { font-size: clamp(2rem, 5vw, 2.75rem); }
  .notfound .lede { margin-inline: auto; }
  .notfound__grid {
    display: grid; gap: 0.75rem; margin: 2.5rem 0 2rem; text-align: left;
  }
  @media (min-width: 640px) { .notfound__grid { grid-template-columns: 1fr 1fr; } }
  .notfound__card {
    display: flex; align-items: center; gap: 1rem; padding: 1rem;
    border: 1px solid var(--line); border-radius: 0.9rem; background: var(--white);
    text-decoration: none; color: var(--ink); transition: background-color 0.2s, border-color 0.2s;
  }
  .notfound__card:hover { background: var(--sand-2); border-color: var(--ink-soft); }
  .notfound__cardicon {
    flex: none; display: grid; place-items: center; width: 2.5rem; height: 2.5rem;
    border-radius: 0.65rem; border: 1px solid var(--line); background: var(--sand); color: var(--ink-soft);
  }
  .notfound__cardtext { min-width: 0; flex-grow: 1; display: grid; gap: 0.1rem; }
  .notfound__cardtext strong { font-size: 0.95rem; }
  .notfound__cardtext span { font-size: 0.85rem; color: var(--ink-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .notfound__arrow { flex: none; color: var(--ink-soft); transition: transform 0.2s; }
  .notfound__card:hover .notfound__arrow { transform: translateX(3px); }
</style>
