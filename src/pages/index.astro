---
import Base from '../layouts/Base.astro';
import Enquire from '../components/Enquire.astro';
import { AUTHOR_NAME, LINKEDIN_URL, FREE_SAMPLE } from '../config.mjs';
const initials = AUTHOR_NAME.split(' ').map((w) => w[0]).join('').slice(0, 2);
---
<Base home description="Practical SEND transition resources, consultancy and tailored support for schools, colleges and local authorities. Post-16, preparing for adulthood, autism and EHCP.">
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">Post-16 SEND &middot; Preparing for adulthood</p>
        <h1>Practical support for better SEND <em>transitions</em>.</h1>
        <p class="lede">Resources, consultancy and tailored support for schools, colleges and local authorities working to improve preparation for adulthood.</p>
        <div class="actions">
          <a class="btn btn--primary" href="/packages/">Explore our services</a>
          <a class="btn btn--ghost" href="/resources/">Shop resources</a>
        </div>
      </div>
      <svg class="hero__art" viewBox="0 0 400 400" role="img" aria-label="Decorative illustration of steps rising from left to right">
        <rect class="s1" x="10" y="290" width="90" height="100" rx="14" />
        <rect class="s2" x="110" y="220" width="90" height="170" rx="14" />
        <rect class="s1" x="210" y="150" width="90" height="240" rx="14" />
        <rect class="s4" x="310" y="80" width="80" height="310" rx="14" />
        <path id="heroPath" class="path" d="M55 265 C 120 200, 170 200, 250 125 S 330 60, 350 45" />
        <circle class="s3" cx="350" cy="45" r="20" />
      </svg>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="paths">
        <div class="path-card path-card--light" data-reveal>
          <span class="path-card__num" aria-hidden="true">01</span>
          <p class="eyebrow">For practitioners</p>
          <h2>Ready-to-use resources</h2>
          <p>Editable templates and practical toolkits that save your team time and give you a clear starting point.</p>
          <a class="btn btn--primary" href="/resources/">Browse resources</a>
        </div>
        <div class="path-card path-card--dark" data-reveal>
          <span class="path-card__num" aria-hidden="true">02</span>
          <p class="eyebrow" style="color:var(--terra-light)">For organisations</p>
          <h2>Consultancy &amp; tailored support</h2>
          <p>Practical reviews, advisory support and bespoke resources designed around your organisation's needs.</p>
          <a class="btn btn--light" href="/packages/">Explore services</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <p class="eyebrow">Who we work with</p>
      <h2>Support for the people responsible for transition.</h2>
      <ul class="features features--4">
        <li data-reveal><h3>Schools</h3><p>Support with post-16 transition planning, provision reviews and practical resources.</p></li>
        <li data-reveal><h3>Colleges</h3><p>Tools and written support to strengthen preparation for adulthood.</p></li>
        <li data-reveal><h3>Local authorities</h3><p>Advisory support, written reviews and bespoke resources.</p></li>
        <li data-reveal><h3>SEND &amp; education organisations</h3><p>Practical resources and specialist project support.</p></li>
      </ul>
      <div style="margin-top:2.5rem">
        <Enquire heading="Have a specific project in mind? Let's talk." text="Tell us what you're working on and we'll recommend an appropriate starting point." />
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>Written, editable and yours to adapt.</h2>
      <ul class="features">
        <li data-reveal><h3>Written, not live</h3><p>Everything is delivered as documents. There are no live sessions, workshops or events.</p></li>
        <li data-reveal><h3>Editable files</h3><p>Templates come in Word so your team can change wording, layout and detail to suit your setting.</p></li>
        <li data-reveal><h3>Plain UK English</h3><p>Clear, calm language that works for staff, families and the young people themselves.</p></li>
      </ul>
    </div>
  </section>

  {FREE_SAMPLE.url && (
    <section class="section">
      <div class="wrap">
        <div class="callout" data-reveal>
          <div>
            <p class="eyebrow">Free sample</p>
            <h2>Try a free template.</h2>
            <p>Download a free sample to see the style and format before you buy.{FREE_SAMPLE.title && <> This one is: {FREE_SAMPLE.title}.</>}</p>
          </div>
          <a class="btn btn--primary" href={FREE_SAMPLE.url}>Get the free sample</a>
        </div>
      </div>
    </section>
  )}

  <section class="section section--dark">
    <div class="wrap">
      <div class="author" data-reveal>
        <span class="monogram" aria-hidden="true">{initials}</span>
        <p>Written by <strong>{AUTHOR_NAME}</strong>, who holds an MSc in Autism Studies and has more than five years' frontline experience supporting young people with SEND in post-16 settings. <a href="/about/">More about us</a> &middot; <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></p>
      </div>
    </div>
  </section>

  <script>
    // The hero's ball climbs the dotted path and rolls back down, on a loop.
    // Skipped entirely for reduced motion — the ball just stays put at the top,
    // exactly as it always has.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const ball = document.querySelector('.hero__art circle.s3');
      const svgNS = 'http://www.w3.org/2000/svg';
      if (ball) {
        // The path already ends at (350,45), where the ball sits by default — start
        // and end the loop there too (keyPoints 1→0→1) so nothing jumps on load or repeat.
        const anim = document.createElementNS(svgNS, 'animateMotion');
        anim.setAttribute('dur', '7s');
        anim.setAttribute('repeatCount', 'indefinite');
        anim.setAttribute('calcMode', 'spline');
        anim.setAttribute('keyPoints', '1;0;1');
        anim.setAttribute('keyTimes', '0;0.5;1');
        anim.setAttribute('keySplines', '0.42 0 0.58 1;0.42 0 0.58 1');
        const mpath = document.createElementNS(svgNS, 'mpath');
        mpath.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', '#heroPath');
        mpath.setAttribute('href', '#heroPath');
        anim.appendChild(mpath);
        ball.setAttribute('cx', '0');
        ball.setAttribute('cy', '0');
        ball.appendChild(anim);
      }
    }
  </script>
</Base>
