---
import Base from '../../layouts/Base.astro';
import docs from '../../../content/legal.json';

export function getStaticPaths() {
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}
const { doc } = Astro.props;
---
<Base title={doc.title} description={doc.description} noindex>
  <section class="page-head"><div class="wrap"><p class="eyebrow">Legal</p><h1>{doc.title}</h1></div></section>
  <section class="section" style="padding-top:1rem">
    <div class="wrap">
      <div class="notice"><p><strong>{doc.draft}</strong> Nothing on this page is final legal wording.</p></div>
      <div class="prose">
        {doc.sections.map((s) => (
          <>
            <h2>{s.heading}</h2>
            <p class="muted">[DRAFT PLACEHOLDER] {s.note}</p>
          </>
        ))}
      </div>
    </div>
  </section>
</Base>
