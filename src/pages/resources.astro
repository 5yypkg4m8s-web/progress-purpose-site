---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Enquire from '../components/Enquire.astro';
import data from '../../content/products.json';
import { PAYMENT_PLATFORM } from '../config.mjs';
const schema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  itemListElement: data.products.map((p, i) => ({
    '@type': 'ListItem', position: i + 1,
    item: { '@type': 'Product', name: p.name, description: p.summary },
  })),
};
---
<Base title="Resources" schema={schema} description="SEND transition templates and toolkits for post-16 settings, delivered as Word and PDF downloads — format varies by resource.">
  <section class="page-head">
    <div class="wrap">
      <img class="page-mark" src="/images/logo-mark.png" alt="" width="320" height="225" />
      <p class="eyebrow">Resources</p>
      <h1>Templates and toolkits, ready to download.</h1>
      <p class="lede">Digital downloads for post-16 transition planning, as Word or PDF — see each resource below for its exact format.</p>
      <p class="lede" style="margin-top:0.75rem">Not sure where to start? Begin with the free guide, try the Starter Pack for ready-to-use templates, then move to the full Transition Planning Toolkit when you need the complete framework.</p>
    </div>
  </section>
  <section class="section" style="padding-top:1rem">
    <div class="wrap">
      <div class="notice" style="margin-bottom:2rem"><p>Resources are bought through {PAYMENT_PLATFORM}'s secure checkout. Card details are entered on {PAYMENT_PLATFORM}, never on this site.</p></div>
      <div class="grid grid--2">
        {data.products.map((item) => <ProductCard item={item} kind="product" />)}
      </div>
      <div style="margin-top:3rem">
        <Enquire heading="Need something more tailored?" text="We work with schools, colleges and local authorities to review provision, develop bespoke resources and provide written advisory support." />
      </div>
      <p class="muted" style="margin-top:2rem">See <a href="/legal/refunds-and-digital-delivery/">refunds and digital delivery</a> and <a href="/legal/licence-terms/">licence terms</a>.</p>
    </div>
  </section>
</Base>
